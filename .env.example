# One API key drives every agent. Copy this file to .env and fill it in.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Leave LLM_BASE_URL empty for OpenAI. For another OpenAI compatible provider set its endpoint, for example:
#   Gemini:        https://generativelanguage.googleapis.com/v1beta/openai/   with LLM_MODEL=gemini-3.5-flash-lite
#   GitHub Models: https://models.github.ai/inference
# LLM_BASE_URL=
